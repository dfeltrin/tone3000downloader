# Copy this file to .env and insert your secret key from TONE3000 Settings > API Keys.
TONE3000_API_KEY=replace-with-your-api-key
# Comma-separated TONE3000 usernames to synchronize.
TONE3000_USERS=2dor,ToneJunkie
# Comma-separated usernames to move from data/User to data/Archived and stop synchronizing.
ARCHIVED=
